class Solution {
    public boolean isMatch(String s, String p) {
        int sIdx = 0, pIdx = 0, lastWildcardIdx = -1, sNextIdx = -1;
        
        while (sIdx < s.length()) {
            // Case 1: Characters match or pattern has '?'
            if (pIdx < p.length() && (p.charAt(pIdx) == '?' || p.charAt(pIdx) == s.charAt(sIdx))) {
                sIdx++;
                pIdx++;
            } 
            // Case 2: Pattern has '*'
            else if (pIdx < p.length() && p.charAt(pIdx) == '*') {
                lastWildcardIdx = pIdx;
                sNextIdx = sIdx;
                pIdx++; // Try matching '*' with empty sequence first
            } 
            // Case 3: Current characters don't match, check if we can backtrack to a '*'
            else if (lastWildcardIdx != -1) {
                pIdx = lastWildcardIdx + 1; // Backtrack pattern to after the '*'
                sNextIdx++; // Match '*' with one more character from s
                sIdx = sNextIdx;
            } 
            // Case 4: No match and no wildcard to backtrack to
            else {
                return false;
            }
        }
        
        // Check for remaining '*' in pattern
        while (pIdx < p.length() && p.charAt(pIdx) == '*') {
            pIdx++;
        }
        
        return pIdx == p.length();
    }
}
